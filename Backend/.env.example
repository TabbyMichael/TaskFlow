# ─── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-base64-64
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ──────────────────────────────────────────────────────────────────
DB_NAME=taskforge_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ─── JWT / Auth ────────────────────────────────────────────────────────────────
# SimpleJWT secret is derived from SECRET_KEY; no extra config required.

# ─── Media / Static ────────────────────────────────────────────────────────────
MEDIA_ROOT=/app/media

# ─── Email (not yet wired — placeholder for future) ────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@taskflow.local
